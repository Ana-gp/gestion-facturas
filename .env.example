# Copiar este archivo a .env.local para desarrollo.
# No introduzcas claves reales en este archivo ni las subas a Git.

# Supabase: URL del proyecto y clave publicable (no la service_role).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Reenvío por correo (#16): dominio de recepción de Resend (<id>.resend.app). Público.
NEXT_PUBLIC_DOMINIO_CORREO=

# Solo servidor: nunca usar el prefijo NEXT_PUBLIC_.
# Clave secreta de Supabase (sb_secret_...): la usa la ruta de lectura con IA
# (#19) para guardar los datos leídos y contar la lectura (reservar_lectura).
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
# Resend (#16): clave de la API y secreto del webhook (whsec_...). Solo servidor.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
